    {
      "name": "profiler_correlated_timeline",
      "description": "Build a time-aligned correlated CPU+GPU timeline from a Metal System Trace.\n\nShows CPU and GPU activity side by side in aligned time buckets,\nwith automatic phase detection (CPU_BOUND, GPU_BOUND, BALANCED, IDLE).\n\nThis is the primary tool for understanding CPU/GPU interaction patterns:\npipeline bubbles, encoding bottlenecks, and GPU-bound regions become\nimmediately visible in the unified timeline.\n\nRequires a .trace file recorded with the Metal System Trace template\n(which captures both time-profile CPU samples and metal-gpu-intervals).\n\nReturns:\n    JSON with timeline buckets, detected phases, and summary analysis.\n",
      "inputSchema": {
        "$defs": {
          "CorrelatedTimelineInput": {
            "description": "Input for correlated CPU+GPU timeline analysis.",
            "properties": {
              "trace_path": {
                "description": "Path to a Metal System Trace .trace file",
                "minLength": 1,
                "title": "Trace Path",
                "type": "string"
              },
              "num_buckets": {
                "anyOf": [
                  {
                    "maximum": 500,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Number of time buckets (default: auto 20-50). Lower = more summary, higher = more detail.",
                "title": "Num Buckets"
              },
              "bucket_ms": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Explicit bucket width in milliseconds (overrides num_buckets).",
                "title": "Bucket Ms"
              },
              "target_process": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Filter CPU samples to a specific process name (substring match).",
                "title": "Target Process"
              }
            },
            "required": [
              "trace_path"
            ],
            "title": "CorrelatedTimelineInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/CorrelatedTimelineInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_correlated_timelineArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_correlated_timelineOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Correlated CPU+GPU Timeline",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
