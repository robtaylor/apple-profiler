    {
      "name": "profiler_query_table",
      "description": "Query any data table by schema name, returning rows as JSON.\n\nThis is a generic tool for accessing any table in the trace, including\nMetal GPU tables (metal-gpu-intervals, metal-driver-intervals,\nmetal-application-command-buffer-submissions, etc.), thermal data,\nor any other instrument data.\n\nUse profiler_list_tables first to discover available schemas.\nEach row is returned as a dict mapping column mnemonics to values.\n\nReturns:\n    JSON with schema info, column definitions, and row data.\n",
      "inputSchema": {
        "$defs": {
          "TableQueryInput": {
            "description": "Input for querying any table by schema name.",
            "properties": {
              "trace_path": {
                "description": "Path to the .trace file",
                "minLength": 1,
                "title": "Trace Path",
                "type": "string"
              },
              "schema": {
                "description": "The table schema name to query (e.g., 'metal-gpu-intervals', 'metal-driver-intervals', 'metal-application-command-buffer-submissions'). Use profiler_list_tables to discover available schemas.",
                "minLength": 1,
                "title": "Schema",
                "type": "string"
              },
              "limit": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Maximum number of rows to return. None returns all.",
                "title": "Limit"
              }
            },
            "required": [
              "trace_path",
              "schema"
            ],
            "title": "TableQueryInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/TableQueryInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_query_tableArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_query_tableOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Query Any Table by Schema",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
