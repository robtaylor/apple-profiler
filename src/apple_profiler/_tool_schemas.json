{
  "tools": [
    {
      "name": "profiler_open_trace",
      "description": "Open a .trace file and return its metadata and available tables.\n\nThis is typically the first tool to call. It parses the trace's table of\ncontents and returns device info, recording duration, target process, and\na list of all available data tables.\n\nReturns:\n    JSON with trace info and available table schemas.\n",
      "inputSchema": {
        "$defs": {
          "TracePathInput": {
            "description": "Input requiring a trace file path.",
            "properties": {
              "trace_path": {
                "description": "Path to the .trace file",
                "minLength": 1,
                "title": "Trace Path",
                "type": "string"
              }
            },
            "required": [
              "trace_path"
            ],
            "title": "TracePathInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/TracePathInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_open_traceArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_open_traceOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Open Trace File",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "profiler_cpu_samples",
      "description": "Get CPU profile samples, each with a full stack trace (backtrace).\n\nEach sample includes timestamp, thread, process, CPU core, thread state,\ncycle weight, and full backtrace with symbol names and binary info.\nWorks with traces from CPU Profiler, Time Profiler, and Metal System Trace.\nOptionally filter to a time range using start_time_ns / end_time_ns.\n\nReturns:\n    JSON array of CPU samples with backtraces.\n",
      "inputSchema": {
        "$defs": {
          "CpuSamplesInput": {
            "description": "Input for querying CPU samples.",
            "properties": {
              "trace_path": {
                "description": "Path to the .trace file",
                "minLength": 1,
                "title": "Trace Path",
                "type": "string"
              },
              "limit": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Maximum number of samples to return. None returns all.",
                "title": "Limit"
              },
              "start_time_ns": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Include only samples at or after this timestamp (nanoseconds).",
                "title": "Start Time Ns"
              },
              "end_time_ns": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Include only samples at or before this timestamp (nanoseconds).",
                "title": "End Time Ns"
              }
            },
            "required": [
              "trace_path"
            ],
            "title": "CpuSamplesInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/CpuSamplesInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_cpu_samplesArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_cpu_samplesOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Get CPU Samples with Stack Traces",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "profiler_top_functions",
      "description": "Get the top N functions by total CPU cycle weight.\n\nAggregates cycle weights across all samples for each function symbol,\nreturning the heaviest functions first. Useful for identifying CPU hotspots.\nWorks with traces from CPU Profiler, Time Profiler, and Metal System Trace.\nOptionally scope to a time range using start_time_ns / end_time_ns.\n\nReturns:\n    JSON array of {function, total_weight} sorted by weight descending.\n",
      "inputSchema": {
        "$defs": {
          "TopFunctionsInput": {
            "description": "Input for top functions query.",
            "properties": {
              "trace_path": {
                "description": "Path to the .trace file",
                "minLength": 1,
                "title": "Trace Path",
                "type": "string"
              },
              "n": {
                "default": 20,
                "description": "Number of top functions to return",
                "maximum": 500,
                "minimum": 1,
                "title": "N",
                "type": "integer"
              },
              "start_time_ns": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Include only samples at or after this timestamp (nanoseconds).",
                "title": "Start Time Ns"
              },
              "end_time_ns": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Include only samples at or before this timestamp (nanoseconds).",
                "title": "End Time Ns"
              }
            },
            "required": [
              "trace_path"
            ],
            "title": "TopFunctionsInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/TopFunctionsInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_top_functionsArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_top_functionsOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Top Functions by Cycle Weight",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
