    {
      "name": "profiler_gpu_dependencies",
      "description": "Analyze buffer dependencies between GPU dispatches.\n\nReturns dependency DAG with critical path length, parallelism\nmetrics, per-kernel edge counts, and buffer hazard details.\nUse scale parameter to view at dispatch, encoder, kernel, or\ncommand buffer granularity.\n",
      "inputSchema": {
        "$defs": {
          "GpuDepsInput": {
            "description": "Input for GPU dependency graph analysis.",
            "properties": {
              "gputrace_path": {
