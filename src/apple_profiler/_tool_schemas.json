    {
      "name": "profiler_gpu_scheduling",
      "description": "Analyze GPU dispatch scheduling overhead to find optimization opportunities.\n\nIdentifies where combining GPU operations would speed things up by\neliminating CPU-GPU scheduling gaps. Uses real GPU hardware timestamps\nto measure:\n\n1. Inter-encoder gaps: Time the GPU sits idle between command encoder\n   submissions (the CPU-GPU roundtrip cost). Combining encoders\n   eliminates these gaps entirely.\n\n2. Dispatch fusion candidates: Sequences of many small dispatches of\n   the same kernel that could be replaced by fewer, larger dispatches.\n\nReturns per-encoder timing breakdown, gap analysis with combine\nassessments, fusion candidates, and prioritized recommendations\nwith estimated savings.\n\nRequires shader profiling data (streamData) in the .gputrace bundle.\n",
      "inputSchema": {
        "$defs": {
          "GpuTracePathInput": {
            "description": "Input requiring a .gputrace file path.",
            "properties": {
              "gputrace_path": {
                "description": "Path to .gputrace file",
                "minLength": 1,
                "title": "Gputrace Path",
                "type": "string"
              }
            },
            "required": [
              "gputrace_path"
            ],
            "title": "GpuTracePathInput",
            "type": "object"
          }
        },
        "properties": {
          "params": {
            "$ref": "#/$defs/GpuTracePathInput"
          }
        },
        "required": [
          "params"
        ],
        "title": "profiler_gpu_schedulingArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "profiler_gpu_schedulingOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Analyze GPU Scheduling Overhead",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
